{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "exclusive": true,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/arch",
    "niri/workspaces",
    "custom/sep",
    "niri/window",
    "custom/sep:1",
    "custom/media-prev",
    "mpris",
    "custom/media-next"
  ],

  "modules-center": [
    "custom/weather",
    "custom/sep:4",
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "custom/sep:2",
    "network",
    "bluetooth",
    "pulseaudio",
    "battery",
    "custom/sep:3",
    "custom/tuned",
    "tray",
    "custom/power"
  ],

  "custom/arch": {
    "format": "󰣇",
    "tooltip": false
  },

  "niri/workspaces": {
    "format": "[{icon}]",
    "format-icons": {
      "active": ">",
      "default": "-",
      "urgent": "!"
    }
  },

  "niri/window": {
    "format": "❯ {}",
    "max-length": 52,
    "separate-outputs": true,
    "rewrite": {
      "": "~"
    }
  },

  "clock": {
    "format": " 󰥔 {:%H:%M}",
    "format-alt": " 󰃭 {:%a, %d %b %Y}",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#00e5ff'><b>{}</b></span>",
        "days": "<span color='#eeffee'><b>{}</b></span>",
        "weekdays": "<span color='#ffe600'><b>{}</b></span>",
        "today": "<span color='#ff0044'><b><u>{}</u></b></span>"
      }
    }
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 2,
    "tooltip": false,
    "states": {
      "high": 70,
      "critical": 90
    }
  },

  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "interval": 5,
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "states": {
      "high": 70,
      "critical": 90
    }
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}% 󰇚{bandwidthDownBytes} 󰕒{bandwidthUpBytes}",
    "format-ethernet": "󰈀 {ifname} 󰇚{bandwidthDownBytes} 󰕒{bandwidthUpBytes}",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "interval": 2,
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "format-disabled": "󰂲",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 mute",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ -l 1.0",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
    "tooltip": false
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 full",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip-format": "{timeTo}\n{power:.1f}W"
  },

  "custom/tuned": {
    "exec": "~/.config/waybar/scripts/tuned-cycle.sh",
    "on-click": "~/.config/waybar/scripts/tuned-cycle.sh click",
    "interval": 10,
    "tooltip": false
  },

  "tray": {
    "spacing": 8,
    "icon-size": 14
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 600,
    "on-click": "xdg-open https://wttr.in",
    "tooltip": true
  },

  "custom/sep:4": {
    "format": "│",
    "tooltip": false,
    "interval": "once"
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "niri msg action quit",
    "tooltip-format": "exit niri"
  },

  "custom/sep": {
    "format": "│",
    "tooltip": false,
    "interval": "once"
  },

  "custom/sep:1": {
    "format": "│",
    "tooltip": false,
    "interval": "once"
  },

  "custom/sep:2": {
    "format": "│",
    "tooltip": false,
    "interval": "once"
  },

  "custom/sep:3": {
    "format": "│",
    "tooltip": false,
    "interval": "once"
  },

  "custom/media-prev": {
    "format": "{}",
    "exec": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused' && echo '󰒮' || echo ''",
    "on-click": "playerctl previous",
    "tooltip": false,
    "interval": 2
  },

  "custom/media-next": {
    "format": "{}",
    "exec": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused' && echo '󰒭' || echo ''",
    "on-click": "playerctl next",
    "tooltip": false,
    "interval": 2
  },

  "mpris": {
    "format": "{status_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "format-stopped": "",
    "status-icons": {
      "playing": "▶",
      "paused": "⏸",
      "stopped": "■"
    },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "max-length": 28,
    "tooltip-format": "{player}\n{title}\n{artist}\n{album}"
  }
}
